void loop() {

	#ifdef debug_code_scanled
	while(1)test_led();
	#endif 
	
	#ifdef debuging_display
	test_scrollUTF();	
	#endif
	
	if(media_manager.playing==1)
	{
		playtext();
	}
#ifdef display_welcome_name
	else{
		display_status_name();		
	}
#else
	else if(check1s())
	{		
		display.clearDisplay();
		display.showBuffer();
	}	
#endif
	
	check_erro_firmOTA();
	
	read_serial();
}
