update by connecting to server
*/
void setup_upgrade_now()
{
	Serial.println("Check for upgrade...");
	//thong bao tao update firm ware
	display_update_enable(true);	
	display.clearDisplay();			
	display.setCursor(2,0);
	display.setTextSize(1);
	display.setTextColor(myGREEN);
	display.print("Update Led By Server.");
	display.showBuffer();
	delay(2000);
	
	display.clearDisplay();	
	display.setCursor(2,0);
	display.setTextColor(myGREEN);
	display.print("Update Led By Server..");
	display.showBuffer();	
	delay(1000);
	
	display.clearDisplay();			
	display.setCursor(2,0);
	display.setTextColor(myGREEN);
	display.print("Update Led By Server...");
	display.showBuffer();
	delay(1000);
	
	display_update_enable(false);
	delay(1000);
	
	upgradenow();
	
}
void set_up_ota_now()
{
	//thong bao tao update firm ware
	display_update_enable(true);	
	display.clearDisplay();			
	display.setCursor(2,0);
	display.setTextSize(1);
	display.setTextColor(myGREEN);
	display.print("Update Led Manual.");
	display.showBuffer();
	delay(2000);
	
	display.clearDisplay();	
	display.setCursor(2,0);
	display.setTextColor(myGREEN);
	display.print("Update Led Manual..");
	display.showBuffer();
	delay(1000);
	
	display.clearDisplay();			
	display.setCursor(2,0);
	display.setTextColor(myGREEN);
	display.print("Update Led Manual...");
	display.showBuffer();
	delay(1000);
	
	display_update_enable(false);
	delay(1000);
	
	Serial.println("OTA now...");
	config_OTA_firmware();

	//them timeout
	
	unsigned int time = millis()+300000;//5 phút		
	// unsigned int time = millis()+30000;//30S phút			
	
	while (time > millis())
	{
		// thêm timeout vào
		server.handleClient();
		delay(1);
	}
	
	Serial.println("Off OTA now...");
			
	// esp_wifi_disconnect();
	server.close();
	server.stop();
	
	WiFi.softAPdisconnect(true);
	ui8_ota_enable=0;
	
	delay(1000);
	display_update_enable(true);
	
	Serial.println("OTA timeout exit");	
	
}
